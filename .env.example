# AI-Powered Personal Task Manager — environment configuration
# Active LLM provider: gemini (only supported real provider) or mock (offline, no API key).
# For offline use without an API key, change this to: LLM_PROVIDER=mock
LLM_PROVIDER=gemini

# Google Gemini API key.
# Leave empty until you have a real key; paste it after the equals sign.
# Keep the real value in .env (ignored by Git), not in this example file.
GOOGLE_API_KEY=

# Gemini model. gemini-1.5-flash and gemini-2.5-flash are no longer
# available to new users. gemini-3.8-flash and 3.7-flash returned 503
# (high demand) during setup; gemini-3.5-flash is supported and working.
GEMINI_MODEL=gemini-3.5-flash

# Optional: database path (defaults to ./tasks.db)
# DATABASE_PATH=./tasks.db

# Optional: timezone used to resolve "today"/relative dates and the LLM prompt.
# Use an IANA name (for example UTC or Asia/Kolkata). Defaults to UTC.
TIMEZONE=UTC

# Optional: bounded retries for transient Gemini 429/503 errors.
# Backoff is exponential: GEMINI_RETRY_BASE_DELAY * 2**attempt.
# GEMINI_MAX_RETRIES=3
# GEMINI_RETRY_BASE_DELAY=0.5

# Optional: debug flag (defaults to false)
# DEBUG=false
